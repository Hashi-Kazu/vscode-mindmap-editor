{
  "name": "vscode-mindmap-editor",
  "displayName": "Markdown マインドマップエディタ",
  "description": "Markdownの見出し・リスト構造をインタラクティブなマインドマップとして表示・編集できるVS Code拡張機能。ファイルごとに独立したビューアを同時に開けます",
  "version": "2.25.1",
  "publisher": "Hashi-Kazu",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hashi-Kazu/vscode-mindmap-editor"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#12121E",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Visualization"],
  "keywords": ["markdown", "mindmap", "mind map", "editor", "visualization"],
  "activationEvents": ["onLanguage:markdown"],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Markdown マインドマップエディタ",
      "properties": {
        "mindmap.viewerMode": {
          "type": "string",
          "enum": [
            "perFile",
            "shared"
          ],
          "default": "perFile",
          "enumDescriptions": [
            "ファイルごとに独立したマインドマップビューアを開き、複数ファイルのビューアを同時に表示できる",
            "1枚のビューアを使い回し、アクティブなMarkdownエディタの切り替えに表示内容を追従させる"
          ],
          "description": "マインドマップビューアの起動単位。perFile: ファイル（URI）ごとに独立したビューアを保持する（既定）。shared: 1枚のビューアがアクティブエディタに追従する（従来動作）"
        },
        "mindmap.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "アクティブなMarkdownエディタが切り替わったとき、マインドマップビューアの表示内容を自動でその.mdファイルに追従させる",
          "markdownDeprecationMessage": "この設定は非推奨です。`#mindmap.viewerMode#` に統合されました。1枚のビューアを追従させる場合は `mindmap.viewerMode` を `shared` に設定してください。"
        },
        "mindmap.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 8,
          "maximum": 32,
          "description": "Font size (px) for the mind map nodes."
        },
        "mindmap.edgeWidth": {
          "type": "number",
          "default": 1.5,
          "minimum": 0.5,
          "maximum": 8,
          "description": "Edge (connection line) width (px) for the mind map. Default: 1.5"
        }
      }
    },
    "commands": [
      {
        "command": "mindmap.openMindMap",
        "title": "マインドマップとして開く",
        "category": "Mind Map",
        "icon": {
          "light": "media/icon.png",
          "dark": "media/icon.png"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mindmap.openMindMap",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "mindmap.openMindMap",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mindmap.openMindMap",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorLangId == markdown"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npx vsce package",
    "lint": "tsc --noEmit -p tsconfig.json && node --check media/mindmap.js",
    "pretest": "node esbuild.test.js",
    "test": "node --test dist-test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
